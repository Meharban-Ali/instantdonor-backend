# ============================================
# APPLICATION ENVIRONMENT VARIABLES - TEMPLATE
# ============================================

# ----------------------------
# SPRING BOOT PROFILE
# ----------------------------
SPRING_PROFILES_ACTIVE=dev
PORT=8090

# ----------------------------
# DATABASE CONFIG
# ----------------------------
# Replace mysql-host with localhost for local running, or database service name inside docker-compose
DB_URL=jdbc:mysql://localhost:3306/blood_donor_db_dev?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=<YOUR_DB_PASSWORD>

REPLICA_DB_URL=jdbc:mysql://localhost:3306/blood_donor_db_dev?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
REPLICA_DB_USERNAME=root
REPLICA_DB_PASSWORD=<YOUR_DB_PASSWORD>

# ----------------------------
# REDIS CONFIG
# ----------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>
REDIS_SSL=false

# ----------------------------
# JWT SECURITY
# ----------------------------
# Secret must be at least 384 bits (48 characters) long for HMAC-SHA384
JWT_SECRET=<YOUR_JWT_SECRET_MIN_48_CHARS>
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ----------------------------
# AI SERVICE
# ----------------------------
AI_SERVICE_URL=http://localhost:8000

# ----------------------------
# EMAIL CONFIG (SMTP / Resend / Mailpit)
# ----------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<YOUR_EMAIL>
MAIL_PASSWORD=<YOUR_EMAIL_APP_PASSWORD>
MAIL_FROM_NAME=Blood Donor Network
MAIL_FROM_ADDRESS=noreply@<YOUR_DOMAIN>
MAIL_REPLY_TO=support@<YOUR_DOMAIN>

# ----------------------------
# TWILIO SMS
# ----------------------------
TWILIO_ACCOUNT_SID=<YOUR_TWILIO_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<YOUR_TWILIO_AUTH_TOKEN>
TWILIO_PHONE_NUMBER=<YOUR_TWILIO_PHONE_NUMBER>
TWILIO_MESSAGING_SERVICE_SID=MGyour_messaging_service_sid_optional
TWILIO_ENABLED=false
APP_NOTIFICATION_SMS_MAX_PER_DONOR_PER_DAY=3
APP_NOTIFICATION_SMS_GLOBAL_DAILY_CAP=500
SMS_EMERGENCY_TEMPLATE="%s: %s blood needed at %s, %s. Units: %d. Open app to respond: %s"

# ----------------------------
# FIREBASE PUSH NOTIFICATIONS
# ----------------------------
FCM_PROJECT_ID=your_fcm_project_id
FCM_SERVICE_ACCOUNT=classpath:firebase-service-account.json

# ----------------------------
# SSL CONFIGURATION
# ----------------------------
SSL_ENABLED=false
SSL_KEYSTORE=classpath:keystore.p12
SSL_KEYSTORE_PASSWORD=your_keystore_password
SSL_KEYSTORE_TYPE=PKCS12
SSL_KEY_ALIAS=tomcat

# ----------------------------
# MONITORING & OBSERVABILITY
# ----------------------------
PROMETHEUS_ENABLED=false
PROMETHEUS_URL=http://localhost:9091
JAEGER_ENDPOINT=http://localhost:14250

# ----------------------------
# INITIAL ADMIN USER CONFIG
# ----------------------------
ADMIN_NAME=Super Admin
ADMIN_EMAIL=<ADMIN_EMAIL>
ADMIN_PHONE=<ADMIN_PHONE>
ADMIN_PASSWORD=<ADMIN_PASSWORD>

# ----------------------------
# RATE LIMITING
# ----------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=100
RATE_LIMITING_LOGIN_IP_CAPACITY=10
RATE_LIMITING_LOGIN_EMAIL_CAPACITY=5
RATE_LIMIT_REFILL_INTERVAL=60
RATE_LIMIT_MAX_PER_MINUTE=100

# ----------------------------
# SESSION CONFIG
# ----------------------------
SESSION_TIMEOUT=30m

# ----------------------------
# CORS (CORS_ALLOWED_ORIGINS)
# ----------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ----------------------------
# LOGGING LEVEL
# ----------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# ----------------------------
# FRONTEND CONFIG
# ----------------------------
FRONTEND_URL=http://localhost:5173
# Cloud production: FRONTEND_URL=https://instantdonor.online

# ----------------------------
# CLOUD / RENDER / NEON PRODUCTION TUNING
# ----------------------------
# Neon PostgreSQL Pooled Connection (PgBouncer, for runtime traffic):
# DB_URL=jdbc:postgresql://<project-id>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require&prepareThreshold=0
# Neon PostgreSQL Direct Connection (Unpooled, for Flyway migrations):
# FLYWAY_DB_URL=jdbc:postgresql://<project-id>.<region>.aws.neon.tech/<dbname>?sslmode=require
# Hikari Pool limits (tune for free DB connection caps):
# DB_POOL_MAX=10
# DB_POOL_MIN_IDLE=2
# Redis URL (Alternative for Render Key Value or Upstash):
# REDIS_URL=rediss://default:<REDIS_PASSWORD>@<host>:<port>
# REDIS_SSL=true
# Resend SMTP config on Render free tier (use port 2587 or 2465):
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=2587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=<YOUR_RESEND_SMTP_KEY>
# MAIL_FROM_ADDRESS=noreply@<YOUR_DOMAIN>
# MAIL_FROM_NAME="AI Blood Donor Network"
# MAIL_REPLY_TO=support@<YOUR_DOMAIN>
# AI Service API Authentication:
# AI_SERVICE_API_KEY=<API_KEY>
