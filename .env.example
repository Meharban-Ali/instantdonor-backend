# ============================================
# APPLICATION ENVIRONMENT VARIABLES - TEMPLATE
# ============================================

# ----------------------------
# SPRING BOOT PROFILE
# ----------------------------
SPRING_PROFILES_ACTIVE=dev
PORT=8090

# ----------------------------
# DATABASE CONFIG
# ----------------------------
# Replace mysql-host with localhost for local running, or database service name inside docker-compose
DB_URL=jdbc:mysql://localhost:3306/blood_donor_db_dev?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

REPLICA_DB_URL=jdbc:mysql://localhost:3306/blood_donor_db_dev?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
REPLICA_DB_USERNAME=root
REPLICA_DB_PASSWORD=your_mysql_password

# ----------------------------
# REDIS CONFIG
# ----------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_SSL=false

# ----------------------------
# JWT SECURITY
# ----------------------------
# Secret must be at least 384 bits (48 characters) long for HMAC-SHA384
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_48_characters_long_for_sha384!
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ----------------------------
# AI SERVICE
# ----------------------------
AI_SERVICE_URL=http://localhost:8000

# ----------------------------
# EMAIL CONFIG (SMTP)
# ----------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ----------------------------
# TWILIO SMS
# ----------------------------
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid_goes_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_goes_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_goes_here

# ----------------------------
# FIREBASE PUSH NOTIFICATIONS
# ----------------------------
FCM_PROJECT_ID=your_fcm_project_id
FCM_SERVICE_ACCOUNT=classpath:firebase-service-account.json

# ----------------------------
# SSL CONFIGURATION
# ----------------------------
SSL_ENABLED=false
SSL_KEYSTORE=classpath:keystore.p12
SSL_KEYSTORE_PASSWORD=your_keystore_password
SSL_KEYSTORE_TYPE=PKCS12
SSL_KEY_ALIAS=tomcat

# ----------------------------
# MONITORING & OBSERVABILITY
# ----------------------------
PROMETHEUS_ENABLED=false
PROMETHEUS_URL=http://localhost:9091
JAEGER_ENDPOINT=http://localhost:14250

# ----------------------------
# INITIAL ADMIN USER CONFIG
# ----------------------------
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@blooddonor.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=your_secure_admin_password_here

# ----------------------------
# RATE LIMITING
# ----------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=100
RATE_LIMITING_LOGIN_IP_CAPACITY=10
RATE_LIMITING_LOGIN_EMAIL_CAPACITY=5
RATE_LIMIT_REFILL_INTERVAL=60
RATE_LIMIT_MAX_PER_MINUTE=100

# ----------------------------
# SESSION CONFIG
# ----------------------------
SESSION_TIMEOUT=30m

# ----------------------------
# CORS (CORS_ALLOWED_ORIGINS)
# ----------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ----------------------------
# LOGGING LEVEL
# ----------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# ----------------------------
# FRONTEND CONFIG
# ----------------------------
FRONTEND_URL=http://localhost:5173
# Cloud production: FRONTEND_URL=https://instantdonor.online

# ----------------------------
# CLOUD / RENDER PRODUCTION TUNING
# ----------------------------
# External MySQL 8 TLS connection:
# DB_URL=jdbc:mysql://<host>:<port>/<dbname>?useSSL=true&requireSSL=true&verifyServerCertificate=true&serverTimezone=UTC
# Hikari Pool limits (tune for free DB connection caps):
# DB_POOL_MAX=10
# DB_POOL_MIN_IDLE=2
# Redis URL (Alternative for Render Key Value or Upstash):
# REDIS_URL=rediss://default:<password>@<host>:<port>
# REDIS_SSL=true
# Resend SMTP config on Render free tier (use port 2587 or 2465):
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=2587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_123456789...
# MAIL_FROM=noreply@instantdonor.online
# MAIL_REPLY_TO=support@instantdonor.online
# AI Service API Authentication:
# AI_SERVICE_API_KEY=your_generated_secret_key_matching_ai_service
