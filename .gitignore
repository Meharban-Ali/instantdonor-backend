# ═══════════════════════════════════════════════
# AI Blood Donor Network — .gitignore
# ═══════════════════════════════════════════════

# ── SECRETS — KABHI PUSH MAT KARO ────────────
.env
application.properties
!src/main/resources/application*.properties
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.pfx
certs/
nginx/certs/
secrets/

# ── LOGS & DUMPS ─────────────────────────────
logs/
*.log
*.hprof
*.dump
*.sql.gz

# ── JAVA / MAVEN ─────────────────────────────
target/
*.class
*.jar
*.war
*.ear
backup_original_jar/
scratch/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── IDE ───────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── REACT / NODE ─────────────────────────────
node_modules/
dist/
build/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── PYTHON ───────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
*.coverage
htmlcov/

# ── LOGS ─────────────────────────────────────
logs/
*.log

# ── UPLOADS & SCREENSHOTS & TEST REPORTS ───────
uploads/
screenshots/
e2e-screenshots/
test-results/
playwright-report/
coverage/
.coverage
htmlcov/
*.png
*.pdf
*.docx

# ── OS ────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── DOCKER ───────────────────────────────────
docker-compose.override.yml